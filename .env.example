# Export these in your shell; biliquill does not automatically load .env files.
BILIQUILL_API_KEY=replace-me
BILIQUILL_BASE_URL=https://api.openai.com/v1
BILIQUILL_MODEL=your-model-name

# Local backends: no cloud key needed. Uncomment the provider you use.
# BILIQUILL_PROVIDER=ollama
# BILIQUILL_OLLAMA_BASE_URL=http://localhost:11434
# BILIQUILL_MODEL=your-installed-model
# BILIQUILL_PROVIDER=local
# BILIQUILL_LOCAL_BASE_URL=http://localhost:1234/v1
# BILIQUILL_LOCAL_API_KEY=optional-local-proxy-key
